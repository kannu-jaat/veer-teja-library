<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1B4B"> <!-- Dark Premium Purple -->

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Profile Card (Dark Blue) -->
    <RelativeLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_dark_card"
        android:padding="20dp">

        <!-- Photo & Camera Icon -->
        <RelativeLayout
            android:id="@+id/imgContainer"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_centerVertical="true">
            <androidx.cardview.widget.CardView
                android:layout_width="85dp"
                android:layout_height="85dp"
                app:cardCornerRadius="45dp"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera" />
            </androidx.cardview.widget.CardView>
            <ImageView
                android:id="@+id/btnUpdatePhoto"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:background="@drawable/circle_purple"
                android:padding="5dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/imgContainer"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvFullNameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvUsernameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username_123"
                android:textColor="#A5B4FC"
                android:textSize="14sp" />
            
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Loading..."
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
            
            <TextView
                android:id="@+id/tvMemberSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Member Since: --"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom White Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/profileHeader"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_top_white"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Info Rows -->
        <include layout="@layout/row_profile_info" android:id="@+id/rowName" />
        <include layout="@layout/row_profile_info" android:id="@+id/rowPhone" />
        <include layout="@layout/row_profile_info" android:id="@+id/rowDob" />
        <include layout="@layout/row_profile_info" android:id="@+id/rowAddress" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Edit Profile & Logout -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Secure Logout"
            android:textColor="#EF4444"
            android:backgroundTint="#FEE2E2"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
